# ═══════════════════════════════════════════════════════════════════════
#  تحصين التشغيل المحلي — انسخ هذا الملف إلى config/env.local ثم صدّره:
#      cp config/env.local.example config/env.local
#      set -a; . ./config/env.local; set +a
#
#  متغيرات البيئة تتفوق على ملف إعداد Paperclip. هذا مقصود:
#  الأمر `paperclipai onboard` يعيد كتابة telemetry.enabled=true في ملف
#  الإعداد (cli/src/commands/onboard.ts:712) — فلا تعتمد على الملف وحده.
# ═══════════════════════════════════════════════════════════════════════

# ── 1. إطفاء كل مسارات الإرسال الخارجي ────────────────────────────────
# التليمتري مفعّلة افتراضيًا في المنصة (server/src/config.ts:356 → ?? true)
PAPERCLIP_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
# فحص التحديثات يستدعي registry.npmjs.org (cli/src/update-notice.ts:17)
PAPERCLIP_UPDATE_CHECK=0

# ── 2. قفل مشاركة بيانات التغذية الراجعة ──────────────────────────────
# هذا هو المسار الوحيد في المنصة الذي قد يحمل نص قضية فعلي خارجًا
# (server/src/services/feedback-share-client.ts:5). نضع الأرضية على المنع.
PAPERCLIP_SETTING_DEFAULTS={"feedbackDataSharingPreference":"not_allowed"}
# إخفاء المفتاح من الواجهة حتى لا يُفعَّل سهوًا، مع تعطيل تصدير/استيراد الشركة
PAPERCLIP_HIDDEN_SETTINGS=instance.general.feedbackDataSharingPreference,company.export

# ── 3. ربط محلي فقط ───────────────────────────────────────────────────
PAPERCLIP_DEPLOYMENT_MODE=local_trusted
PAPERCLIP_BIND=loopback
HOST=127.0.0.1
PAPERCLIP_HOME=$HOME/.paperclip

# ── 4. مفتاح النموذج — المسار الخارجي الوحيد المسموح ──────────────────
# ضع مفتاحك هنا. هذا هو الاستثناء الوحيد لقاعدة "لا شيء يغادر الجهاز":
# نص القضية يمر عبر واجهة Anthropic للاستدلال فقط.
ANTHROPIC_API_KEY=

# ═══════════════════════════════════════════════════════════════════════
#  متغيرات يجب أن تبقى غير معرّفة — أي قيمة تعيد تفعيل قناة خارجية.
#  scripts/verify-isolation.sh يفشل إذا وُجد أي منها.
#
#   SENTRY_DSN, SENTRY_DSN_BACKEND, SENTRY_DSN_FRONTEND
#   OTEL_EXPORTER_OTLP_ENDPOINT
#   PAPERCLIP_TELEMETRY_ENDPOINT, PAPERCLIP_TELEMETRY_BACKEND_URL
#   PAPERCLIP_FEEDBACK_EXPORT_BACKEND_URL
#   PAPERCLIP_CLOUD_TENANT_SERVER_TOKEN, PAPERCLIP_MANAGED_CONFIG
#   PAPERCLIP_ID_CONNECTOR_*
#   GITHUB_TOKEN, GH_TOKEN, PAPERCLIP_GITHUB_TOKEN, PAPERCLIP_GIT_TOKEN
#   PAPERCLIP_STORAGE_PROVIDER (يجب أن يبقى local_disk)
#   DATABASE_URL (اتركه فارغًا لاستخدام Postgres المضمّن محليًا)
# ═══════════════════════════════════════════════════════════════════════
